# Porta do servidor
PORT=3000

# Senha do painel (usuário pode ser qualquer um). Deixe vazio só para testar localmente.
ADMIN_PASSWORD=troque-esta-senha

# --- IA (Claude / Anthropic) ---
# Crie sua chave em https://console.anthropic.com
ANTHROPIC_API_KEY=
# Opcional: modelo e esforço (low = mais rápido e barato; medium/high = mais caprichado)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=low
# Segundos que a IA espera antes de responder (junta mensagens picadas do lead)
REPLY_DELAY_SECONDS=8

# --- Captação ---
# Token exigido no endpoint /api/capture (?token=...). Recomendado.
CAPTURE_TOKEN=um-token-secreto

# --- WhatsApp Cloud API (Meta) --- sem isso, roda em modo simulador
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=um-token-para-o-webhook
# Template aprovado para a 1ª mensagem (com variável {{1}} = primeiro nome)
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
